#!/bin/sh
# dsh-purge shim begin
if [ -z "${DSH_HOME:-}" ]; then
  _dsh_shim_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
  for _dsh_rel in "$_dsh_shim_dir/.dsh" "$_dsh_shim_dir/../.dsh" "$_dsh_shim_dir/../../.dsh"; do
    if [ -d "$_dsh_rel" ]; then DSH_HOME=$(CDPATH= cd -- "$_dsh_rel" && pwd); export DSH_HOME; break; fi
  done
  unset _dsh_shim_dir _dsh_rel
fi
# dsh-purge shim end
# dsh-purge boot hook (2026-11-25): 每次启动自动重打补丁，幂等、失败不阻塞
/opt/node/bin/node /root/workspace/purge-boot.mjs >/dev/null 2>&1 || true

# ---- dsh stop / start / restart / status（2026-11-28 加）----
# 为什么要这三个：壳只认 /tmp/dsh-stop.marker，别的都当「该重启」。
# 有命令之后，「我要停」和「我要重启」不必再靠手动碰文件。
_dsh_engine_pid() {
  for _p in $(ls /proc | grep -E '^[0-9]+$'); do
    _c=$(tr '\0' ' ' < /proc/$_p/cmdline 2>/dev/null) || continue
    case "$_c" in *"dsh/lib/bin.js web"*) echo "$_p"; return 0;; esac
  done
  return 1
}
_dsh_port_open() {
  curl -s -o /dev/null --max-time 2 http://127.0.0.1:3080/ 2>/dev/null
}
case "$1" in
  status)
    _e=$(_dsh_engine_pid || echo '-')
    _s=$(ps -eo pid,cmd | grep "[/]usr/local/bin/dsh web" | awk '{print $1}' | head -1)
    echo "壳(容器入口): ${_s:-无}"
    echo "引擎: ${_e}"
    _dsh_port_open && echo "3080: 通" || echo "3080: 不通"
    for _k in "虚拟引擎.py" "虚拟对话.py" "eigenflux"; do
      _n=$(ps -eo cmd | grep -F -c "$_k")
      echo "常驻[$_k]: $_n"
    done
    exit 0;;
  stop)
    echo '停止：写 stop 标记并结束引擎，壳见到标记后退出（容器随之结束）'
    : > /tmp/dsh-stop.marker
    _e=$(_dsh_engine_pid) && { kill -TERM "$_e"; echo "已通知引擎 $_e 退出"; } || echo "引擎本来就没在跑"
    exit 0;;
  start)
    rm -f /tmp/dsh-stop.marker
    if _dsh_port_open; then echo "已经在跑（3080 通），不用拉"; exit 0; fi
    echo '拉起引擎（脱离当前会话，日志 /tmp/dsh-web.log）'
    setsid nohup /opt/node/bin/node --import=/opt/dsh-go/boot-cache.mjs \
      /opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js web "$@" \
      --patch /etc/dsh-app/dsh-web.patch.yml >> /tmp/dsh-web.log 2>&1 < /dev/null &
    _i=0
    while [ $_i -lt 60 ]; do _dsh_port_open && { echo "起来了（${_i}s）"; exit 0; }; sleep 1; _i=$((_i+1)); done
    echo "60 秒还没通，看 /tmp/dsh-web.log"; exit 1;;
  restart)
    rm -f /tmp/dsh-stop.marker
    _e=$(_dsh_engine_pid) || { echo "引擎没在跑；用 dsh start 拉起"; exit 1; }
    # 2026-11-28：重启分三步——广播落断点 → 宽限 8 秒让各轮收尾 → 才换引擎
    python3 /root/workspace/记忆档案/断点广播.py "dsh restart" 2>/dev/null || true
    echo "已广播停止并生成断点，宽限 8 秒后换引擎 $_e"
    sleep 8
    _dsh_stop_clean "$_e"
    rm -f /tmp/dsh-port.lock
    echo "已停机清理，下一轮由壳拉起新引擎"; exit 0;;
esac

# dsh-app shim: run the bundled DeepSeek Harness CLI with the bundled Node.
# `dsh web` (the app's launch) preloads the boot cache, /opt/dsh-go/boot-cache.mjs.
# 2026-11-28 引路人：「不杀容器不行么」——改成看护壳：容器入口是这层 sh，引擎是它的子进程。
# 这样 kill 引擎只是重启引擎，容器（proot）与常驻（虚拟引擎/ollama）都不用陪葬。
# 只有 web 子命令走看护；其它用法保持 exec 语义。

# ---- 停机清理：杀整棵进程树 → 等进程与端口都干净 → 再放开端口仲裁（2026-11-28 引路人指出的坑）----
# 坑：旧引擎的残留子进程没清干净时，端口仲裁会把新引擎判成「冲突方」，于是它避让、再避让，进退避循环。
_dsh_kill_tree() {
  _r=$1
  for _k in $(ps -eo pid,ppid | awk -v r="$_r" '$2==r{print $1}'); do
    _dsh_kill_tree "$_k"
  done
  kill -TERM "$_r" 2>/dev/null || true
}
_dsh_port_busy() { curl -s -o /dev/null --max-time 1 http://127.0.0.1:3080/ 2>/dev/null; }
_dsh_stop_clean() {
  _p=$1
  [ -n "$_p" ] || return 0
  : > /tmp/dsh-port.lock          # 拿锁：这段时间里端口检查不作数
  _dsh_kill_tree "$_p"
  _i=0
  while [ $_i -lt 20 ]; do
    [ -d "/proc/$_p" ] || break
    sleep 0.5; _i=$((_i+1))
  done
  _j=0
  while _dsh_port_busy && [ $_j -lt 20 ]; do sleep 0.5; _j=$((_j+1)); done
  printf '[%s] 停机清理：pid=%s 进程%s 端口%s\n' "$(date '+%F %T')" "$_p" \
    "$([ -d /proc/$_p ] && echo 残留 || echo 干净)" "$(_dsh_port_busy && echo 仍占用 || echo 已释放)" >> /tmp/engine-supervisor.log
}
if [ "$1" = web ]; then
  # 2026-11-28：壳从「看护引擎」升级成「真正的监工」——
  # 以前它前台阻塞在 node 上，引擎不死它什么都不看，孤儿进程死了没人管；
  # 现在引擎放后台、壳自己每 5 秒转一圈：resident 缺谁补谁，引擎没了就拉。
  _ensure() {                      # $1=匹配串  $2=启动命令
    # 2026-11-28：不能用裸 grep——我自己跑的调试命令里带同样的字符串，会让它误判「已经在跑」。
    # 只认「真进程」：命令行以 python3 或 eigenflux 开头。
    if ! ps -eo cmd | grep -F "$1" | grep -qE "^(python3|/root/\.local/bin/eigenflux)"; then
      sh -c "setsid nohup $2 >> /tmp/resident.log 2>&1 < /dev/null &"
      printf '[%s] 补起常驻：%s\n' "$(date '+%F %T')" "$1" >> /tmp/engine-supervisor.log
    fi
  }
  while :; do
    : > /tmp/dsh-shell-monitor.marker      # 刷新时间戳：监工看到它就不碰引擎（避免两个拉起者打架）
    _ensure "壳下挂.py" "python3 -u /root/workspace/记忆档案/壳下挂.py"
    _ensure "通道看门狗.py" "python3 -u /root/workspace/记忆档案/通道看门狗.py"
    _ensure "虚拟引擎.py --watch" "python3 -u /root/workspace/dsh-ctxc/scripts/虚拟引擎.py --watch"
    _ensure "虚拟对话.py" "python3 -u /root/workspace/dsh-ctxc/scripts/虚拟对话.py --watch --interval 120"
    _ensure "eigenflux --homedir /root/.eigenflux --runtime-mode skill watch" "/root/.local/bin/eigenflux --homedir /root/.eigenflux --runtime-mode skill watch --dispatch"

    if [ ! -f /tmp/dsh-port.lock ] && curl -s -o /dev/null --max-time 2 http://127.0.0.1:3080/ 2>/dev/null; then
      sleep 5
      continue
    fi
    python3 /root/workspace/记忆档案/壳下挂.py --pre >> /tmp/壳下挂.log 2>&1 || true
    printf '{"boot":"%s","at":"%s"}' "$(date +%s)" "$(date '+%F %T')" \
      > /opt/dsh/node_modules/@deepseek-ai/dsh-web-frontend/dist/reload.json 2>/dev/null || true
    _t0=$(date +%s)
    /opt/node/bin/node --import=/opt/dsh-go/boot-cache.mjs /opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js "$@" &
    _ep=$!
    # 2026-11-28 修（实测翻车）：原来 `wait` 会一直阻塞到引擎退出，等于引擎活着的整段时间壳什么都不看——
    # 杀掉常驻没人补，监视形同虚设。改成「活着就每 5 秒巡逻，死了才收尸」。
    while kill -0 "$_ep" 2>/dev/null; do
      : > /tmp/dsh-shell-monitor.marker
      _ensure "壳下挂.py" "python3 -u /root/workspace/记忆档案/壳下挂.py"
      _ensure "通道看门狗.py" "python3 -u /root/workspace/记忆档案/通道看门狗.py"
      _ensure "虚拟引擎.py --watch" "python3 -u /root/workspace/dsh-ctxc/scripts/虚拟引擎.py --watch"
      _ensure "虚拟对话.py" "python3 -u /root/workspace/dsh-ctxc/scripts/虚拟对话.py --watch --interval 120"
      _ensure "eigenflux --homedir /root/.eigenflux --runtime-mode skill watch" "/root/.local/bin/eigenflux --homedir /root/.eigenflux --runtime-mode skill watch --dispatch"
      sleep 5
    done
    wait "$_ep"
    _code=$?
    _dt=$(( $(date +%s) - _t0 ))
    printf '[%s] engine exit=%s 运行=%ss\n' "$(date '+%F %T')" "$_code" "$_dt" >> /tmp/engine-supervisor.log
    python3 /root/workspace/记忆档案/断点.py sweep --force >> /tmp/engine-supervisor.log 2>&1 || true
    if [ -f /tmp/dsh-stop.marker ]; then
      printf '[%s] 见到停止标记，壳退出\n' "$(date '+%F %T')" >> /tmp/engine-supervisor.log
      break
    fi
    sleep 3
  done
  exit 0
fi
exec /opt/node/bin/node /opt/dsh/node_modules/@deepseek-ai/dsh/lib/bin.js "$@"
